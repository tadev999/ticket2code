#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
OS_NAME="$(uname -s 2>/dev/null || echo unknown)"

case "$OS_NAME" in
  MINGW*|MSYS*|CYGWIN*)
    if command -v pwsh >/dev/null 2>&1; then
      exec pwsh -NoProfile -File "$SCRIPT_DIR/figma_export_svg.ps1" "$@"
    fi
    if command -v powershell >/dev/null 2>&1; then
      exec powershell -NoProfile -File "$SCRIPT_DIR/figma_export_svg.ps1" "$@"
    fi
    ;;
esac

exec "$SCRIPT_DIR/figma_export_svg.sh" "$@"

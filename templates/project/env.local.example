JIRA_TOKEN=your_token_here
JIRA_EMAIL=your_atlassian_email@company.com
JIRA_URL=your_jira_base_url

# --- Optional: corporate proxy (leave commented if you have no proxy) ---
# URL-encode special characters in USER/PASS: @ -> %40, : -> %3A, / -> %2F, # -> %23, space -> %20
# Example password "p@ss:1" becomes "p%40ss%3A1".
#HTTPS_PROXY="http://USER:PASS@proxy.host:PORT"
#HTTP_PROXY="http://USER:PASS@proxy.host:PORT"
#NO_PROXY="localhost,127.0.0.1,.company.local"

# --- Optional: corporate CA bundle (only if you hit CERTIFICATE_VERIFY_FAILED) ---
#REQUESTS_CA_BUNDLE="/absolute/path/to/corp-ca.pem"
#PIP_CERT="/absolute/path/to/corp-ca.pem"
#CURL_CA_BUNDLE="/absolute/path/to/corp-ca.pem"
